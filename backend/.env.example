# JWT 签名（必填，无默认值）
secret_key=replace-with-a-long-random-string

# SQLite 路径（相对 backend/ 解析为绝对路径并创建父目录）
database_path=data/Wedding_Master.db

# 监听地址
host=127.0.0.1

# Agent 开发端口
port=8099

# CORS 来源（JSON 列表）
cors_origins=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175"]

# 日历「今天」时区
timezone=Asia/Shanghai

# JWT 算法
jwt_algorithm=HS256

# 未勾选记住时 JWT 过期（分钟）
jwt_expire_minutes_session=720

# 勾选记住时 JWT / Cookie 过期（天）
jwt_expire_days_remember=30

# 密码哈希轮次
bcrypt_rounds=12

# 找回密码验证码有效期（秒）
password_reset_ttl_seconds=300

# 找回密码验证码重发间隔（秒）
password_reset_resend_seconds=60

# 短信通道：mock 或 aliyun
sms_mode=mock

# EXT-001 AccessKey ID
aliyun_sms_access_key_id=

# EXT-001 AccessKey Secret
aliyun_sms_access_key_secret=

# 已审核短信签名
aliyun_sms_sign_name=

# 已审核短信模板
aliyun_sms_template_code=

# 号码认证短信认证 endpoint（个人开发者 SendSmsVerifyCode）
aliyun_sms_endpoint=https://dypnsapi.aliyuncs.com

# 保留字段。个人短信认证请求不发送 RegionId
aliyun_sms_region=cn-hangzhou

# TemplateParam 变量名
aliyun_sms_template_param_key=code

# 短信 httpx 超时（秒）
aliyun_sms_timeout_seconds=10

# Deepseek 通道：mock 或 live
deepseek_mode=mock

# EXT-002 Bearer
deepseek_api_key=

# Chat Completions 根地址
deepseek_base_url=https://api.deepseek.com

# 新对话默认模型
deepseek_default_model=deepseek-flash

# 输入框可选模型（JSON 列表）
deepseek_allowed_models=["deepseek-flash","deepseek-v4-pro"]

# 单次生成 max_tokens
deepseek_max_tokens=8192

# 整次调用上限（秒）
deepseek_timeout_seconds=90

# 流式两次增量之间空闲超时（秒）
deepseek_idle_timeout_seconds=45

# 单条用户文字 Unicode 码点上限
xiaobei_max_text_chars=4000

# 单张对话图片字节上限
xiaobei_max_image_bytes=5242880

# 对话图片落盘目录（相对 backend/）
xiaobei_image_dir=data/xiaobei_images

# 每个婚礼项目的照片张数上限
wedding_photo_max_count=6

# 档案单张照片字节上限
wedding_photo_max_bytes=5242880

# 档案照片落盘目录（相对 backend/）
wedding_photo_dir=data/wedding_photos

# EXT-002 thinking.type
deepseek_thinking_type=disabled

# EXT-002 reasoning_effort
deepseek_reasoning_effort=none

# 受控故障注入：false 时忽略请求头 X-Xiaobei-Test-Fault；仅测试打开
xiaobei_fault_injection=false
